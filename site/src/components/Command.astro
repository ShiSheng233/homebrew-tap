---
// A shell command with a copy button (the handler lives in Base.astro).
interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="command">
  <code><span class="command__prompt" aria-hidden="true">$ </span>{command}</code>
  <button type="button" data-copy={command} aria-label={`Copy “${command}”`}>
    <svg viewBox="0 0 14 14" width="13" height="13" aria-hidden="true">
      <rect x="4.5" y="4.5" width="8" height="8" rx="1.8" />
      <path d="M9.5 2.2A1.6 1.6 0 0 0 8.1 1.5H3.3A1.8 1.8 0 0 0 1.5 3.3v4.8a1.6 1.6 0 0 0 .7 1.4" />
    </svg>
    <span>Copy</span>
  </button>
</div>

<style>
  .command {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0.55rem 0.55rem 0.55rem 1rem;
    border-radius: var(--radius-small);
    background: var(--bg-raised);
  }

  code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.86rem;
    line-height: 1.5;
    scrollbar-width: none;
  }

  .command__prompt {
    color: var(--ink-muted);
    user-select: none;
  }

  button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  button:hover {
    background: color-mix(in srgb, var(--ink) 7%, var(--bg-raised));
    color: var(--ink);
  }

  @media (max-width: 520px) {
    button span {
      display: none;
    }
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
</style>
