---
// A terminal prompt on an ink tile: the tap is used from the command line.
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg class:list={['mark', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" />
  <path d="M9 11l5 5-5 5M16.5 21.5H23" />
</svg>

<style>
  .mark rect {
    fill: var(--ink);
  }

  .mark path {
    fill: none;
    stroke: var(--bg);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
