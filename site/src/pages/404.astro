---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <div class="missing">
    <h1>Page not found</h1>
    <p>There is nothing at this address.</p>
    <p>The <a href="/">home page</a> lists everything in the tap.</p>
  </div>
</Base>

<style>
  .missing {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(3.5rem, 12vh, 8rem) var(--gutter) 0;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: 2.6rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  p {
    margin: 0 0 0.5rem;
    color: var(--ink-muted);
  }
</style>
