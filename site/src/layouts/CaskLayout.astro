---
import type { MarkdownHeading } from 'astro';
import type { Cask } from '../lib/cask';
import Base from './Base.astro';

interface Props {
  casks: Cask[];
  current: Cask;
  description: string;
  headings: Pick<MarkdownHeading, 'depth' | 'slug' | 'text'>[];
}

const { casks, current, description, headings } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

<Base title={current.name} description={description}>
  <div class="layout">
    <div class="sidebar">
      <nav class="toc" aria-label="On this page">
        <p class="sidebar__title">On this page</p>
        <ul>
          {sections.map((section) => (
            <li><a href={`#${section.slug}`}>{section.text}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="casks" aria-label="Packages">
        <p class="sidebar__title">Packages</p>
        <ul>
          {casks.map((cask) => (
            <li>
              <a href={`/${cask.token}`} aria-current={cask.token === current.token ? 'page' : undefined}>
                {cask.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <article class="page">
      <details class="disclosure disclosure--casks">
        <summary>Packages</summary>
        <ul>
          {casks.map((cask) => (
            <li>
              <a href={`/${cask.token}`} aria-current={cask.token === current.token ? 'page' : undefined}>
                {cask.name}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <slot name="header" />

      <details class="disclosure disclosure--toc">
        <summary>On this page</summary>
        <ul>
          {sections.map((section) => (
            <li><a href={`#${section.slug}`}>{section.text}</a></li>
          ))}
        </ul>
      </details>

      <div class="content">
        <slot />
      </div>
    </article>
  </div>
</Base>

<script>
  // Marks the section being read in the contents list.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((link) => [
      decodeURIComponent(link.hash.slice(1)),
      link,
    ]),
  );
  const headings = [...document.querySelectorAll<HTMLHeadingElement>('.content h2[id]')];
  let current: HTMLAnchorElement | undefined;

  function update() {
    const line = window.innerHeight * 0.25;
    let active = headings[0];
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= line) active = heading;
    }
    const link = active && links.get(active.id);
    if (link === current) return;
    current?.removeAttribute('aria-current');
    link?.setAttribute('aria-current', 'location');
    current = link;
  }

  if (headings.length) {
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width));
    justify-content: center;
    column-gap: var(--column-gap);
    max-width: calc(var(--page-width) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 2.25rem var(--gutter) 0;
  }

  .sidebar {
    display: none;
    position: sticky;
    top: calc(var(--header-height) + 3.5rem);
    align-self: start;
    max-height: calc(100vh - var(--header-height) - 5rem);
    overflow-y: auto;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: var(--sidebar-width) minmax(0, var(--content-width));
      padding-top: 3.5rem;
    }

    .sidebar {
      display: block;
    }

    .disclosure {
      display: none;
    }
  }

  .sidebar__title {
    margin: 0 0 0.6rem;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .sidebar ul,
  .disclosure ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .casks a {
    display: block;
    margin: 0 0 0.15rem -0.7rem;
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.35;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .casks a:hover {
    color: var(--ink);
    background: var(--bg-raised);
    text-decoration: none;
  }

  .casks a[aria-current='page'] {
    color: var(--ink);
    background: var(--bg-raised);
    font-weight: 500;
  }

  /* Widened by the links' inset so the scroll box doesn't clip their highlight. */
  .sidebar {
    margin-left: -0.7rem;
    padding-left: 0.7rem;
  }

  .toc {
    margin-bottom: 2.25rem;
  }

  .toc ul {
    border-left: 1px solid var(--rule-soft);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.28rem 0 0.28rem 0.9rem;
    border-left: 1px solid transparent;
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.4;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .toc a[aria-current='location'] {
    color: var(--ink);
    border-left-color: var(--ink);
    font-weight: 500;
  }

  .disclosure {
    margin: 0 0 2rem;
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }

  .disclosure--casks {
    margin-bottom: 2.25rem;
  }

  .disclosure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.94rem;
    list-style: none;
  }

  .disclosure summary::-webkit-details-marker {
    display: none;
  }

  .disclosure summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.25rem;
    border-right: 1.5px solid var(--ink-muted);
    border-bottom: 1.5px solid var(--ink-muted);
    transform: translateY(-25%) rotate(45deg);
    transition: transform 150ms ease-out;
  }

  .disclosure[open] summary::after {
    transform: translateY(25%) rotate(-135deg);
  }

  .disclosure ul {
    margin-bottom: 0.9rem;
    font-size: 0.94rem;
  }

  .disclosure li {
    padding: 0.2rem 0;
  }

  .disclosure a[aria-current='page'] {
    color: var(--ink);
    font-weight: 500;
  }

  /* Text from content/*.mdx and the generated sections share these styles. */
  .content :global(h2) {
    margin: 2.75rem 0 0.75rem;
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .content :global(h2:first-child) {
    margin-top: 0;
  }

  .content :global(h3) {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.06rem;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1rem;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.3rem;
  }

  .content :global(li) {
    margin-bottom: 0.4rem;
  }

  .content :global(li::marker) {
    color: var(--ink-muted);
  }

  .content :global(p a),
  .content :global(li a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--link) 40%, transparent);
  }

  .content :global(p a:hover),
  .content :global(li a:hover) {
    text-decoration-color: var(--link);
  }

  .content :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--bg-raised);
  }

  .content :global(pre) {
    margin: 0 0 1rem;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border-radius: var(--radius-small);
    background: var(--bg-raised) !important;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-small);
  }
</style>
